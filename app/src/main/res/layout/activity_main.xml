<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="Logo SEMAWIT"
            android:src="@drawable/logosemawit" />

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppinsbold"
            android:text="SEMAWIT"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppinsregular"
            android:text="Sistem Manajemen Hasil Panen Terhadap\nPerawatan Lahan Perkebunan Kelapa Sawit"
            android:textAlignment="center"
            android:textColor="@color/text_muted1"
            android:textSize="12sp" />

        <!-- 1. Tombol Onboarding -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@color/semawit_btn_green"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <Button
                android:id="@+id/btnStartOnboarding"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="@font/poppinsbold"
                android:text="Lihat Onboarding"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </androidx.cardview.widget.CardView>

        <!-- 2. Tombol Project Lama -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/biskuat_red"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <Button
                android:id="@+id/btnMyProject"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="@font/poppinsbold"
                android:text="Detail Snack Biskuat"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </androidx.cardview.widget.CardView>

        <!-- 3. Tombol Web -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/green_500"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <Button
                android:id="@+id/btnOpenWeb"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="@font/poppinsbold"
                android:text="Buka Informasi Web"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </androidx.cardview.widget.CardView>

        <!-- 4. Tombol Profil Developer -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#2196F3"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <Button
                android:id="@+id/btnDeveloper"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="@font/poppinsbold"
                android:text="Profil Developer"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </androidx.cardview.widget.CardView>

        <!-- 5. Tombol Logout -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#555555"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="@font/poppinsbold"
                android:text="Logout"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>