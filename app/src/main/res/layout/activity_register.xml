<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/semawit_green"
    android:orientation="vertical">

    <!-- HEADER HIJAU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppinsbold"
            android:text="Create Account"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- KONTEN MELENGKUNG -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/surface_base"
        app:cardElevation="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.TopRounded"
        app:strokeWidth="0dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">

                <!-- Full Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/poppinsbold"
                    android:text="Full Name"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etRegName"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_pill"
                    android:fontFamily="@font/poppinsregular"
                    android:hint="Riska Anjani"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="20dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#8BA896"
                    android:textSize="14sp" />

                <!-- Email (Otomatis dari GmailActivity & terkunci) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/poppinsbold"
                    android:text="Email"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etRegEmail"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_pill"
                    android:enabled="false"
                    android:fontFamily="@font/poppinsregular"
                    android:hint="example@gmail.com"
                    android:paddingHorizontal="20dp"
                    android:textColor="#4B6B58"
                    android:textSize="14sp" />

                <!-- Username -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/poppinsbold"
                    android:text="Username (Tanpa Spasi)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etRegUsername"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_pill"
                    android:fontFamily="@font/poppinsregular"
                    android:hint="riskaanjani"
                    android:inputType="text"
                    android:paddingHorizontal="20dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#8BA896"
                    android:textSize="14sp" />

                <!-- Password -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/poppinsbold"
                    android:text="Password"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etRegPassword"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_pill"
                    android:fontFamily="@font/poppinsregular"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:paddingHorizontal="20dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#8BA896"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/poppinsregular"
                    android:text="By continuing, you agree to\nTerms of Use and Privacy Policy."
                    android:textAlignment="center"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegisterSubmit"
                    android:layout_width="210dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/semawit_green"
                    android:fontFamily="@font/poppinsbold"
                    android:text="Sign Up"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:cornerRadius="25dp" />

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>