<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppinsbold"
            android:text="Form Registrasi"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <!-- Nama -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <EditText
                android:id="@+id/etRegName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppinsregular"
                android:hint="Nama Lengkap"
                android:paddingHorizontal="16dp"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <!-- Email (Otomatis terisi & tidak boleh diubah) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#E0E0E0"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <EditText
                android:id="@+id/etRegEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:enabled="false"
                android:fontFamily="@font/poppinsregular"
                android:hint="Email Gmail"
                android:paddingHorizontal="16dp"
                android:textColor="#555555"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <!-- Username (Tidak boleh mengandung spasi) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <EditText
                android:id="@+id/etRegUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppinsregular"
                android:hint="Username (Tanpa Spasi)"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <!-- Password (Minimal 6 karakter) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <EditText
                android:id="@+id/etRegPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppinsregular"
                android:hint="Password (Min. 6 Karakter)"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <!-- Tombol Register -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/semawit_btn_green"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <Button
                android:id="@+id/btnRegisterSubmit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="@font/poppinsbold"
                android:text="Register Sekarang"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>