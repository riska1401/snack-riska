<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/semawit_green"
    android:orientation="vertical">

    <!-- Bagian Atas (Hijau Tua) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvWelcome2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppinsbold"
            android:text="Apakah Anda Siap\nMengelola Lahan Sawit?"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bagian Bawah (Background Putih/Hijau Muda) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8">

        <!-- Lengkungan Atas Menggunakan ShapeableImageView Bawaan -->
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F2FBF4"
            app:shapeAppearanceOverlay="@style/TopRoundedCorner" />

        <!-- Konten di Atas Background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo SEMAWIT / Ilustrasi -->
            <ImageView
                android:id="@+id/imgOnboarding2"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:contentDescription="Logo SEMAWIT"
                android:scaleType="fitCenter"
                android:src="@drawable/logosemawit" />

            <!-- Tombol Ke Halaman Selanjutnya -->
            <TextView
                android:id="@+id/btnNext2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppinsbold"
                android:padding="8dp"
                android:text="Buka Web Informasi"
                android:textColor="#0E6B37"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Indikator Kapsul/Kotak (Halaman 2 Aktif) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#D0E8D7"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    app:cardBackgroundColor="#00A859"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</LinearLayout>