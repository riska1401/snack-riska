<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="Gmail Logo"
        android:src="@drawable/logosemawit" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppinsbold"
        android:text="Register With Gmail"
        android:textColor="@color/text_primary"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppinsregular"
        android:text="Masukkan email berdomain @gmail.com Anda"
        android:textAlignment="center"
        android:textColor="@color/text_muted1"
        android:textSize="12sp" />

    <!-- Card Input Email -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#C8E6C9"
        app:strokeWidth="1dp">

        <EditText
            android:id="@+id/etGmailInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:fontFamily="@font/poppinsregular"
            android:hint="contoh@gmail.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="#111111"
            android:textColorHint="#888888"
            android:textSize="14sp" />
    </androidx.cardview.widget.CardView>

    <!-- Tombol Lanjut -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/semawit_btn_green"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <Button
            android:id="@+id/btnSubmitGmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="@font/poppinsbold"
            android:text="Lanjut Registrasi"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </androidx.cardview.widget.CardView>

</LinearLayout>