<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Logo SEMAWIT -->
    <ImageView
        android:id="@+id/imgAuthLogo"
        android:layout_width="185dp"
        android:layout_height="185dp"
        android:contentDescription="Logo"
        android:src="@drawable/logosemawit" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppinsbold"
        android:text="Silakan Login"
        android:textColor="@color/text_primary"
        android:textSize="24sp" />

    <!-- CardView untuk Input Username agar ada batasan/shadow jelas -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#C8E6C9"
        app:strokeWidth="1dp">

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:fontFamily="@font/poppinsregular"
            android:hint="Username"
            android:paddingHorizontal="16dp"
            android:textColor="#111111"
            android:textColorHint="#888888"
            android:textSize="14sp" />
    </androidx.cardview.widget.CardView>

    <!-- CardView untuk Input Password -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#C8E6C9"
        app:strokeWidth="1dp">

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:fontFamily="@font/poppinsregular"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="#111111"
            android:textColorHint="#888888"
            android:textSize="14sp" />
    </androidx.cardview.widget.CardView>

    <!-- Tombol Login -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/semawit_btn_green"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="@font/poppinsbold"
            android:text="Login"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#E8F5E9"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/semawit_btn_green"
        app:strokeWidth="1dp">

        <Button
            android:id="@+id/btnGoToRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="@font/poppinsbold"
            android:text="Register With Gmail"
            android:textColor="@color/semawit_green"
            android:textSize="15sp" />
    </androidx.cardview.widget.CardView>

</LinearLayout>