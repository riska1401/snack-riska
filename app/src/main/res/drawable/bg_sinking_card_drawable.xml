<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bayangan halus -->
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A084727" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Kartu Utama Bergradien Hijau Tua + Garis Tepi Emas -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#0C6237"
                android:startColor="#084727"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="#E5A922" />
        </shape>
    </item>
</layer-list>