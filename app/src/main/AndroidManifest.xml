<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IKABiskuat">

        <!-- 1. Splash Screen (Layar Awal) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Auth Activity (Halaman Login) -->
        <activity
            android:name=".AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4. Onboarding 1 -->
        <activity
            android:name=".Onboarding1Activity"
            android:exported="false" />

        <!-- 5. Onboarding 2 -->
        <activity
            android:name=".Onboarding2Activity"
            android:exported="false" />

        <!-- 6. Web Activity -->
        <activity
            android:name=".WebActivity"
            android:exported="false" />

        <!-- 7. Profil Developer -->
        <activity
            android:name=".DeveloperActivity"
            android:exported="false" />

        <!-- Detail Biskuat (Project Lama) -->
        <activity
            android:name=".pertemuan3.DetailBiskuatActivity"
            android:exported="false" />

    </application>

</manifest>